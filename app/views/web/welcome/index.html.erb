<main class="flex-shrink-0">
  <div class="container mx-auto mt-12 px-4">
    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow font-medium">
      <h1 class="text-4xl font-bold">
        <%= t('.hello_from_hexlet') %>
      </h1>
      <p class="mt-1 text-lg">
        <%= t('.hexlet_description') %>
      </p>
      <h2 class="mt-6 text-2xl font-bold">
        <%= t('.analyzer_title') %>
      </h2>
      <p class="mt-1 text-base">
        <%= t('.analyzer_description') %>
      </p>
      <%= button_to t('.analyzer_link'),
              '#',
              class: 'mt-4 inline-block rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700' %>
    </div>
  </div>
</main>
